@page "/ResetPassword"
@using MyBlazorAppSourse.Services;
@using MyBlazorAppSourse.Models;
@using System.Net;
@inject NavigationManager NavigationManager
@inject UserService UserService
@using BlazorApp1.Components

<div class="text-center fullscreen text box">
    <div class="body">
        <div id="pictures" class="last"></div>
        <div id="contactform" class="column half">
            <div class="title-text text-start p-2 col-md-6">
            </div>
            
                <_PasswordInput @bind-Value="Password" plaseholder="Password" OnFocus="ClearError" IsDisable="@isDisable"/>
            <_PasswordInput @bind-Value="ConfPassword" plaseholder="Confirm Password" IsDisable="@isDisable" />
                 <div class="@classStyle" role="alert">@error</div>
            <_ButtonSubmit OnClick="ChangePassword" ButtnText="Submit" ButtnType="btn-primary" IsDisable="@isDisable" />
        </div>
    </div>
</div>



@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Email { get; set; }
    private string? Password { get; set; }
    private string? ConfPassword { get; set; }
    private string? error = string.Empty;
    private string? classStyle = string.Empty;
    private bool isDisable;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
            Token = Uri.UnescapeDataString(Token);
        if (!string.IsNullOrEmpty(Email))
            Email = Uri.UnescapeDataString(Email);
    }
    private async Task ChangePassword()
    {
        isDisable = true;
        if(Password == ConfPassword)
        {
            ResetPasswordModel resetPassword = new ResetPasswordModel
                {
                    Token = Token,
                    Email = Email,
                    Password = Password
                };

            var response = await UserService.ResetPassword(resetPassword);
            if (response == true)
            {
                isDisable = false;
                NavigationManager.NavigateTo("/");
            }
        }
        else
        {
            error = "Password not match";
            classStyle = "alert alert-danger";
            isDisable = false;
        }

    }

    private void ClearError()
    {
        error = string.Empty;
        classStyle = string.Empty;
    }

}
