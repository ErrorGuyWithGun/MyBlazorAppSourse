@page "/ForgotPassword"
@using MyBlazorAppSourse.Services;
@inject UserService UserService
@using BlazorApp1.Components

<PageTitle>ForgotPassword</PageTitle>

<div class="text-center fullscreen text box">
    <div class="body">
        <div id="pictures" class="last"></div>
        <div id="contactform" class="column half">
            <div class="title-text text-start p-2 col-md-6">
                <span class="fw-light">We will send your password! </span>
            </div>
            <_EmailInput @bind-Value="email" OnFocus="ClearError" IsDisable="@isDisable" />
            <div class="@classStyle" role="alert">@error</div>
            <_ButtonSubmit ButtnType="btn-primary" IsDisable="@isDisable" ButtnText="Submit" OnClick="ForgotPasswordEmail" />
        </div>
    </div>
</div>

@code{
    private string? email;
    private string error;
    private bool isDisable;
    private string? classStyle = string.Empty;

    private void ClearError()
    {
        error = string.Empty;
        classStyle = string.Empty;
    }
    private async Task ForgotPasswordEmail()
    {
        isDisable = true;
        if (!string.IsNullOrEmpty(email)){
            var user = await UserService.GetIfUserExist(email);
            if (user == true){
                bool sendEmail = await UserService.ForgotPassword(email);
                if (sendEmail == true)
                {
                    error = "Email Sent!";
                    classStyle = "alert alert-primary";
                    isDisable = false;
                }
                else
                {
                    error = "Email Can't Be Sent Right Now!";
                    classStyle = "alert alert-danger";
                    isDisable = false;
                }

            }
            else{ 
                error = "User Dosn't Exist"; 
                classStyle = "alert alert-danger";
                isDisable = false;
            }
        }
        else{
            error = "User Dosn't Exist";
            classStyle = "alert alert-danger";
            isDisable = false;
        }

    }
}