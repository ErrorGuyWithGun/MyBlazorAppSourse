@using MyBlazorAppSourse.Models
@inject MyBlazorAppSourse.Services.InventoryService InventoryService

<EditForm Model="@Item">
    <DataAnnotationsValidator />

    <InputText @bind-Value="@Item.Title"
               maxlength="@maxLength"
               class="form-control form-control-sm m-1"
               placeholder="Title"
               aria-label=".form-control-sm example" />

    <InputText @bind-Value="@Item.Price"
               maxlength="@maxLength"
               class="form-control form-control-sm m-1"
               placeholder="Price"
               aria-label=".form-control-sm example" />

    <div class="m-1">
        <InputTextArea @bind-Value="@Item.Description"
                       maxlength="@maxLengthAreatext"
                       class="form-control"
                       placeholder="Description"
                       id="commentText"
                       rows="3" />
    </div>
</EditForm>
@code {
    [Parameter]
    public ItemModel Item { get; set; }
    public const int maxLength = 255;
    public const int maxLengthAreatext = 1000;

}
