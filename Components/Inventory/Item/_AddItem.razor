@using MyBlazorAppSourse.Models
@using MyBlazorAppSourse.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ItemModel ItemSingleton

<EditForm Model="@ItemSingleton">
    <DataAnnotationsValidator />

    <InputText @bind-Value="@ItemSingleton.Title"
               maxlength="@maxLength"
               class="form-control form-control-sm m-1"
               placeholder="Title"
               aria-label=".form-control-sm example" />

    <InputText @bind-Value="@ItemSingleton.Price"
               maxlength="@maxLength"
               class="form-control form-control-sm m-1"
               placeholder="Price"
               aria-label=".form-control-sm example" />

    <div class="m-1">
        <InputTextArea @bind-Value="@ItemSingleton.Description"
                       maxlength="@maxLengthAreatext"
                       class="form-control"
                       placeholder="Description"
                       id="commentText"
                       rows="3" />
    </div>

</EditForm>

@code {
    [Parameter]
    public Guid inventoryId { get; set; }
    public const int maxLength = 255;
    public const int maxLengthAreatext = 1000;

    protected override async Task OnParametersSetAsync()
    {
        ItemSingleton.inventoryId = inventoryId;
        ItemSingleton.Title = string.Empty;
        ItemSingleton.Price = string.Empty;
        ItemSingleton.Description = string.Empty;
    }

}