@inject MyBlazorAppSourse.Services.UserService UserService

    <span>@UserName</span>


@code {
    [Parameter]
    public string UserId { get; set; }

    private string UserName { get; set; } 

    protected override async Task OnParametersSetAsync()
    {
        var user = await UserService.GetIfIdExist(UserId);
        UserName = user.UserName ;
    }
}