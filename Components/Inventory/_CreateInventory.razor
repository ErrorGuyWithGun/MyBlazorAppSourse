@using MyBlazorAppSourse.Models
@inject MyBlazorAppSourse.Services.InventoryService InventoryService
@inject InventoryModel InventorySingleton


<div class=" col">
    <div class="form-check form-switch">
        <input @bind=InventorySingleton.isPublic class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Public You'r Inventory</label>
    </div>
    <input @bind=InventorySingleton.Name class="form-control  form-control-lg mb-2" type="text" placeholder="Tittle" aria-label=".form-control-lg example">
      
  
    <span>Select Category</span>
    <select @bind=InventorySingleton.categoryId class="form-select form-select-lg mb-3" aria-label="Large select example">
        @foreach (CategoryModel category in categories)
        {
            <option value=@category.Id selected>@category.Name</option>
        }
    </select>
        
 </div>

 

@code {
    public List<CategoryModel> categories { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        InventorySingleton.Name = string.Empty;
        InventorySingleton.isPublic = false;
        categories = await InventoryService.GetAllCategory();
    }
}
