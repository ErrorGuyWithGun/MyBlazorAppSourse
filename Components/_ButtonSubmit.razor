
<div class="d-grid gap-2 p-2 ">
    <button 
        type="submit"
            class=" btn btn-text @ButtnType @Style"
            disabled ="@IsDisable"
            data-bs-toggle="@dataBsToggle"
            data-bs-target="@dataBsTarget"
            @onclick = "HandleClick" >@ButtnText</button>
</div>


@code {
    [Parameter]
    public EventCallback OnClick { get; set;}

    [Parameter]
    public string? ButtnText { get; set; }

    [Parameter]
    public string? ButtnType { get; set; }
    [Parameter]
    public string? dataBsToggle { get; set; }
    [Parameter]
    public string? dataBsTarget { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public bool? IsDisable { get; set; } = false;


    private async Task HandleClick()
    {
        await OnClick.InvokeAsync();
    }
}

